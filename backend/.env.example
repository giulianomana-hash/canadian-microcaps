# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=                  # legacy JWT anon key (starts with eyJ)

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Scheduled refresh (twice-daily SEDAR+ poll) ---
# Generate any long random string. The cron job must send the same value
# as a bearer token.
REFRESH_SECRET=

# --- Resend (optional email notifications). If unset, emails are skipped. ---
RESEND_API_KEY=
RESEND_FROM=SedarWatchlist <onboarding@resend.dev>
NOTIFY_EMAIL=
